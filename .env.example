# RKA platform configuration.
#
#   cp .env.example .env && chmod 600 .env
#   # set POSTGRES_PASSWORD, then:
#   docker compose up -d
#
# Compose reads this file for both variable interpolation and container
# environment. Never commit the real .env.
#
# The previous Node server read AI_ENDPOINT / AI_MODEL / AI_API_KEY /
# AI_GATEWAY_NAME. They map to RKA_AI_ENDPOINT / RKA_AI_MODEL /
# RKA_AI_API_KEY / RKA_AI_GATEWAY_NAME; the Go application ignores the
# unprefixed names.

# ---------------------------------------------------------------- required
# PostgreSQL password for the bundled database. Use a long random value.
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# ---------------------------------------------------------------- application
# Public HTTP port on the host. The Go app itself listens on 0.0.0.0:8080
# inside the Compose network.
RKA_PORT=8080
# Image tag built by `docker compose build` (pin releases, do not use latest).
RKA_IMAGE=rka
RKA_IMAGE_TAG=local
RKA_LOG_LEVEL=info
RKA_LOG_FORMAT=json
# auto | always | never. "auto" follows the request scheme (HTTP on a LAN keeps
# working, TLS gets Secure cookies).
RKA_COOKIE_SECURE=auto
# Trust X-Forwarded-* headers only when a reverse proxy sets them.
RKA_TRUST_PROXY=false
RKA_SESSION_TTL=720h

# ---------------------------------------------------------------- first admin
# Optional. When set, `rka init` creates this administrator idempotently.
# When empty, create the first admin through the one-time bootstrap token in
# data/secrets/bootstrap-token: POST /api/auth/bootstrap.
RKA_ADMIN_EMAIL=
RKA_ADMIN_PASSWORD=
RKA_ADMIN_DISPLAY_NAME=

# ---------------------------------------------------------------- model access
# Server-side model gateway. The browser never receives these values.
# The upstream must be an OpenAI-compatible Chat Completions endpoint.
RKA_AI_ENDPOINT=
RKA_AI_MODEL=
RKA_AI_API_KEY=
RKA_AI_GATEWAY_NAME=
RKA_AI_MAX_CONCURRENCY=3
# Daily AI call budget. 0 means unlimited (not recommended for shared use).
RKA_AI_DAILY_BUDGET=0
RKA_AI_TIMEOUT=120s

# ---------------------------------------------------------------- teaching
# Compose starts DeepTutor and local embeddings by default. The Go worker
# bootstraps a private native admin and merges only RKA-owned model profiles.
# Leave ADMIN_PASSWORD empty to derive it from the persistent application key.
# For an existing external DeepTutor installation, set its actual admin password.
# Explicitly empty RKA_DEEPTUTOR_URL selects the direct gateway-only mode.
RKA_DEEPTUTOR_URL=http://deeptutor:8001
RKA_DEEPTUTOR_ADMIN_USERNAME=rka-admin
RKA_DEEPTUTOR_ADMIN_PASSWORD=
RKA_EMBEDDING_URL=http://embedding:80/v1/embeddings
RKA_EMBEDDING_MODEL=Xenova/bge-small-zh-v1.5
RKA_EMBEDDING_DIMS=512

# ---------------------------------------------------------------- worker
RKA_WORKER_CONCURRENCY=2
RKA_WORKER_POLL=2s
RKA_WORKER_LEASE_TTL=60s
RKA_WORKER_HEARTBEAT=15s
RKA_WORKER_MAX_ATTEMPTS=3

# ---------------------------------------------------------------- retention
RKA_RETENTION_TASK_DAYS=90
RKA_RETENTION_EVENT_DAYS=30
RKA_RETENTION_AUDIT_DAYS=365
RKA_RETENTION_BACKUP_DAYS=30
RKA_RETENTION_LOG_DAYS=30

# ---------------------------------------------------------------- dependency images
# DeepTutor and TEI are included in the default Compose deployment.
# The model gateway is optional: COMPOSE_PROFILES=gateway docker compose up -d
RKA_DEEPTUTOR_IMAGE=ghcr.io/hkuds/deeptutor:1.6.15
RKA_EMBEDDING_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9
# Keep MODEL_ID, RKA_EMBEDDING_MODEL and RKA_EMBEDDING_DIMS consistent.
RKA_EMBEDDING_MODEL_ID=Xenova/bge-small-zh-v1.5
RKA_MAGPIE_IMAGE=ghcr.io/yetone/magpie:0.1.1893
# Protect the Magpie management UI. Separately configure a named gateway key
# as RKA_AI_API_KEY; MAGPIE_WEB_KEY is not the inference gateway key.
MAGPIE_WEB_KEY=
