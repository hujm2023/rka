# Dependency and build output (all component directories)
node_modules/
dist/
/backend/bin/
/rka
*.tsbuildinfo
*.test

# Runtime state, backups, model caches and local records
# Also covers backend/data if the CLI is run there without explicit paths.
data/
/data-verify/
/restore-drill/

# Local secrets and Compose overrides
.env
.env.*
!.env.example
/docker/rka.env
/deploy/rka.env
/docker-compose.override.yml
/docker-compose.override.yaml
/compose.override.yml
/compose.override.yaml

# Test and profiling output
test-results/
playwright-report/
blob-report/
coverage/
coverage.out
*.prof
*.log

# Development-process documents and screenshots; keep durable docs beside code
/docs/
/spec/
/specs/
/implements/
/implementation/

# Temporary and tool cache files
/tmp/
/temp/
.cache/
__pycache__/
*.pyc
*.tmp
*.swp
*.swo
.DS_Store
